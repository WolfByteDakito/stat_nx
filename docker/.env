# Variables d'environnement Docker - DEV LOCAL UNIQUEMENT
# (le projet etant transportable, ces valeurs par defaut sont volontairement simples)

MYSQL_ROOT_PASSWORD=root_dev_only
MYSQL_DATABASE=nx_licenses_stats
MYSQL_USER=nx_app
MYSQL_PASSWORD=nx_app_pwd

# Port MySQL expose sur l'hote (3307 pour eviter collision avec MySQL local existant)
MYSQL_HOST_PORT=3307
